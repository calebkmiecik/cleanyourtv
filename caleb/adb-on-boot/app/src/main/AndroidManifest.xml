<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Android 14 requires it for a job that waits for a network -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Granted once over ADB: pm grant com.caleb.adbonboot android.permission.WRITE_SECURE_SETTINGS -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <application android:label="Debugging on at start" android:allowBackup="false">
        <receiver android:name=".BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <!-- an update of this app drops the Wi-Fi watch; take it up again -->
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <service android:name=".Wake" android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <!-- For a test run from adb (`am start -n com.caleb.adbonboot/.RunNow`); only holders of
             WRITE_SECURE_SETTINGS, such as the adb shell, may start it. -->
        <activity android:name=".RunNow" android:exported="true"
            android:permission="android.permission.WRITE_SECURE_SETTINGS"
            android:theme="@android:style/Theme.NoDisplay" />
    </application>
</manifest>
